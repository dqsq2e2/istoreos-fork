From: BDY-G98 port <noreply@example.invalid>
Date: Fri, 24 Jul 2026 01:32:00 +0800
Subject: [PATCH] usb: gadget: support RockUSB storage selection

RKDevTool selects the target storage before writing a raw image, even when
RockUSB was already started on that device.  Map the Rockchip media ids for
the storage implemented by this board to their U-Boot block devices: eMMC,
SATA and the first NVMe device.  Scan the selected bus and reject the
request when no corresponding block device exists.

Return the active media bitmap through command 0x2b, adapt the storage ID
string to the selected target and advertise storage switching in the
capability response.  Media absent from the G98 or this build remain
rejected.

Signed-off-by: BDY-G98 port <noreply@example.invalid>
---
 arch/arm/include/asm/arch-rockchip/f_rockusb.h |  2 +
 drivers/usb/gadget/f_rockusb.c                 | 92 +++++++++++++++++++++++++-
 2 files changed, 91 insertions(+), 3 deletions(-)

diff --git a/arch/arm/include/asm/arch-rockchip/f_rockusb.h b/arch/arm/include/asm/arch-rockchip/f_rockusb.h
--- a/arch/arm/include/asm/arch-rockchip/f_rockusb.h
+++ b/arch/arm/include/asm/arch-rockchip/f_rockusb.h
@@ -64,6 +64,8 @@ enum rkusb_command {
 K_FW_SPI_READ_10 = 0x21,
 K_FW_SPI_WRITE_10 = 0x22,
 K_FW_LBA_ERASE_10 = 0x25,
+K_FW_CHANGE_STORAGE = 0x2A,
+K_FW_READ_STORAGE = 0x2B,
 
 K_FW_READ_CAPABILITY = 0xAA,
 K_FW_SESSION = 0X30,
diff --git a/drivers/usb/gadget/f_rockusb.c b/drivers/usb/gadget/f_rockusb.c
--- a/drivers/usb/gadget/f_rockusb.c
+++ b/drivers/usb/gadget/f_rockusb.c
@@ -561,16 +561,23 @@ static void cb_read_storage_id(struct usb_ep *ep, struct usb_request *req)
 	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
 				 sizeof(struct fsg_bulk_cb_wrap));
 	struct f_rockusb *f_rkusb = get_rkusb();
-	char emmc_id[] = "EMMC ";
+	const char *storage_id = "UNKN ";
 
 	printf("read storage id\n");
 	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
 
+	if (!strcmp(f_rkusb->dev_type, "mmc"))
+		storage_id = "EMMC ";
+	else if (!strcmp(f_rkusb->dev_type, "scsi"))
+		storage_id = "SATA ";
+	else if (!strcmp(f_rkusb->dev_type, "nvme"))
+		storage_id = "PCIE ";
+
 	/* Prepare for sending subsequent CSW_GOOD */
 	f_rkusb->tag = cbw->tag;
 	f_rkusb->in_req->complete = tx_handler_send_csw;
 
-	rockusb_tx_write_str(emmc_id);
+	rockusb_tx_write_str(storage_id);
 }
 
 struct rk_flash_info {
@@ -624,7 +631,7 @@ static void cb_read_capability(struct usb_ep *ep, struct usb_request *req)
 	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
 				 sizeof(struct fsg_bulk_cb_wrap));
 	struct f_rockusb *f_rkusb = get_rkusb();
-	u8 capability[8] = { 0x05 };
+	u8 capability[8] = { 0x05, 0x02 };
 
 	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
 	f_rkusb->tag = cbw->tag;
@@ -631,6 +638,82 @@ static void cb_read_capability(struct usb_ep *ep, struct usb_request *req)
 	f_rkusb->in_req->complete = tx_handler_send_csw;
 	rockusb_tx_write((char *)capability, sizeof(capability));
 }
+
+static int rockusb_change_storage(struct f_rockusb *f_rkusb, u8 storage)
+{
+	struct blk_desc *desc;
+	char *type;
+	const char *scan_command;
+	unsigned int index = 0;
+
+	switch (storage) {
+	case 1:
+		type = "mmc";
+		scan_command = "mmc dev 0";
+		break;
+	case 10:
+		type = "scsi";
+		scan_command = "scsi scan";
+		break;
+	case 11:
+		type = "nvme";
+		scan_command = "nvme scan";
+		break;
+	default:
+		printf("Rockusb storage id %u is not supported\n", storage);
+		return -ENODEV;
+	}
+
+	if (run_command(scan_command, 0))
+		return -ENODEV;
+	desc = blk_get_dev(type, index);
+	if (!desc || desc->type == DEV_TYPE_UNKNOWN) {
+		printf("Rockusb storage %s %u is not available\n", type, index);
+		return -ENODEV;
+	}
+
+	f_rkusb->dev_type = type;
+	f_rkusb->dev_index = index;
+	f_rkusb->desc = desc;
+	printf("Rockusb storage set to %s %u\n", type, index);
+
+	return 0;
+}
+
+static void cb_change_storage(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	u8 status = CSW_GOOD;
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+	f_rkusb->tag = cbw->tag;
+	if (rockusb_change_storage(f_rkusb, cbw->CDB[1]))
+		status = CSW_FAIL;
+	rockusb_tx_write_csw(cbw->tag, 0, status, USB_BULK_CS_WRAP_LEN);
+}
+
+static void cb_read_storage(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	u32 storage = 0;
+
+	if (!strcmp(f_rkusb->dev_type, "mmc"))
+		storage = 1U << 1;
+	else if (!strcmp(f_rkusb->dev_type, "scsi"))
+		storage = 1U << 10;
+	else if (!strcmp(f_rkusb->dev_type, "nvme"))
+		storage = 1U << 11;
+	storage = cpu_to_le32(storage);
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+	rockusb_tx_write((char *)&storage, sizeof(storage));
+}
 
 int __weak rk_get_bootrom_chip_version(unsigned int *chip_info, int size)
 {
@@ -939,6 +1022,14 @@ static const struct cmd_dispatch_info cmd_dispatch_info[] = {
 		.cmd = K_FW_LBA_ERASE_10,
 		.cb = cb_erase_lba,
 	},
+	{
+		.cmd = K_FW_CHANGE_STORAGE,
+		.cb = cb_change_storage,
+	},
+	{
+		.cmd = K_FW_READ_STORAGE,
+		.cb = cb_read_storage,
+	},
 	{
 		.cmd = K_FW_READ_CAPABILITY,
 		.cb = cb_read_capability,
-- 
2.43.0
