From: BDY-G98 port <noreply@example.invalid>
Date: Fri, 24 Jul 2026 21:25:00 +0800
Subject: [PATCH] usb: gadget: negotiate RockUSB DWC3 max transfer

Rockchip's RKDevTool selects its WriteLBA command size from the high byte of
the TEST_UNIT_READY CSW residue. Match the official Rockchip loader: report
exponent 0x0a (4 MiB) for the DWC3 0xf7 probe and 0x06 (256 KiB) otherwise.

The upstream RockUSB function serializes USB receive and blk_dwrite, so the
64 KiB fallback limits both USB and eMMC throughput. Allocate a 4 MiB request
buffer for the negotiated DWC3 path. Keep the upload scratch buffer at 64 KiB
to avoid placing 4 MiB on the U-Boot stack.

Signed-off-by: BDY-G98 port <noreply@example.invalid>
---
 arch/arm/include/asm/arch-rockchip/f_rockusb.h | 4 ++--
 drivers/usb/gadget/f_rockusb.c                  | 4 +++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/arch/arm/include/asm/arch-rockchip/f_rockusb.h b/arch/arm/include/asm/arch-rockchip/f_rockusb.h
--- a/arch/arm/include/asm/arch-rockchip/f_rockusb.h
+++ b/arch/arm/include/asm/arch-rockchip/f_rockusb.h
@@ -19,7 +19,7 @@
 #define RX_ENDPOINT_MAXIMUM_PACKET_SIZE_1_1  0x0040
 #define TX_ENDPOINT_MAXIMUM_PACKET_SIZE      0x0040
 
-#define EP_BUFFER_SIZE			(64 * 1024)
+#define EP_BUFFER_SIZE			(4 * 1024 * 1024)
 /*
  * EP_BUFFER_SIZE must always be an integral multiple of maxpacket size
  * (64 or 512 or 1024), else we break on certain controllers like DWC3
@@ -27,7 +27,7 @@
  */
 
 #define RKUSB_BUF_SIZE		EP_BUFFER_SIZE * 2
-#define RKBLOCK_BUF_SIZE		EP_BUFFER_SIZE
+#define RKBLOCK_BUF_SIZE		(64 * 1024)
 
 #define RKUSB_STATUS_IDLE			0
 #define RKUSB_STATUS_CMD			1
diff --git a/drivers/usb/gadget/f_rockusb.c b/drivers/usb/gadget/f_rockusb.c
--- a/drivers/usb/gadget/f_rockusb.c
+++ b/drivers/usb/gadget/f_rockusb.c
@@ -551,9 +551,11 @@ static void cb_test_unit_ready(struct usb_ep *ep, struct usb_request *req)
 {
 	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
 				 sizeof(struct fsg_bulk_cb_wrap));
+	u8 max_transfer_exp;
 
 	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+	max_transfer_exp = cbw->CDB[1] == 0xf7 ? 0x0a : 0x06;
 
-	rockusb_tx_write_csw(cbw->tag, cbw->data_transfer_length,
+	rockusb_tx_write_csw(cbw->tag, max_transfer_exp,
 			     CSW_GOOD, USB_BULK_CS_WRAP_LEN);
 }
